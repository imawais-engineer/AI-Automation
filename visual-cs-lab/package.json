{
  "name": "visual-cs-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visual CS Lab — interactive Computer Science learning platform with an algorithm visualization and video rendering Studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imawais-engineer/AI-Automation.git",
    "directory": "visual-cs-lab"
  },
  "keywords": [
    "computer-science",
    "algorithms",
    "data-structures",
    "visualization",
    "education",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "test": "node --import tsx --test server/algorithms/*.test.ts server/render/*.test.ts server/routes/*.test.ts server/ops/*.test.ts server/ui/*.test.ts server/*.test.ts",
    "test:api": "node --import tsx --test server/routes/*.test.ts",
    "test:queue": "node --import tsx --test server/render/watchdog.test.ts server/render/queue-reliability.test.ts",
    "test:backup": "node --import tsx --test server/ops/*.test.ts",
    "test:ui": "node --import tsx --test server/ui/*.test.ts",
    "backup": "node --import tsx server/ops/backup-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
