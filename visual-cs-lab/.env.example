# Visual CS Lab — environment template.
#
# Copy to `.env` next to this file; `server/index.ts` loads it at boot and real
# environment variables always win over the file. Every value below is optional:
# the app boots, renders and passes its tests with no external service at all.

# --- server ------------------------------------------------------------------
PORT=3000

# Where SQLite (lab.db) and rendered MP4s live. The defaults are under /tmp, which
# a reboot can clear — point these somewhere permanent to keep content and videos.
DATA_DIR=./.data
MEDIA_DIR=./.data/media

# --- voice-over narration (Deepgram) -----------------------------------------
# Without the key the Studio shows "provider not configured" and refuses to
# record; everything else keeps working.
DEEPGRAM_API_KEY=
# DEEPGRAM_BASE_URL=https://api.deepgram.com
# DEEPGRAM_TTS_MODEL=flux-naveen-en

# --- AI-assisted drafting (reserved) -----------------------------------------
# Stored for the drafting phase; nothing reads these yet.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
